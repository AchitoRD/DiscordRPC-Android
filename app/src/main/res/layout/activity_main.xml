<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/circle_purple"
        android:alpha="0.15"
        android:layout_gravity="top|end"
        android:layout_marginTop="-50dp"
        android:layout_marginEnd="-60dp" />

    <View
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:background="@drawable/circle_blue"
        android:alpha="0.1"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="100dp"
        android:layout_marginStart="-40dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="48dp"
            android:paddingBottom="32dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_launcher"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DiscordRPC"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rich Presence para movil"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v3.1"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- STATUS CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/glass_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <View android:id="@+id/tvStatusDot" android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/dot_gray" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="  ESTADO" android:textColor="@color/text_secondary" android:textSize="11sp" android:letterSpacing="0.08" />
                    </LinearLayout>

                    <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Inactivo" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="14dp"
                        android:padding="14dp"
                        android:background="@drawable/glass_input">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📱" android:textSize="20sp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="APP ACTUAL" android:textColor="@color/text_hint" android:textSize="10sp" android:letterSpacing="0.08" />
                            <TextView android:id="@+id/tvCurrentApp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Esperando..." android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="2dp" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvAppName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/text_hint" android:textSize="10sp" android:fontFamily="monospace" android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- TOKEN CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/glass_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="DISCORD TOKEN" android:textColor="@color/text_secondary" android:textSize="11sp" android:letterSpacing="0.08" />
                        <Button android:id="@+id/btnHowToken" android:layout_width="wrap_content" android:layout_height="30dp" android:text="¿Como obtener?" android:textAllCaps="false" android:textSize="11sp" android:textColor="@color/text_accent" android:background="@android:color/transparent" android:minHeight="0dp" android:minWidth="0dp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:gravity="center_vertical">
                        <EditText android:id="@+id/etToken" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:hint="token..." android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:backgroundTint="@color/discord_blurple" android:inputType="textPassword" android:singleLine="true" android:textSize="13sp" android:fontFamily="monospace" android:paddingHorizontal="14dp" android:background="@drawable/glass_input" />
                        <Button android:id="@+id/btnShowToken" android:layout_width="wrap_content" android:layout_height="46dp" android:text="Mostrar" android:textAllCaps="false" android:textSize="11sp" android:textColor="@color/text_secondary" android:background="@android:color/transparent" android:minHeight="0dp" android:minWidth="0dp" />
                        <Button android:id="@+id/btnClearToken" android:layout_width="wrap_content" android:layout_height="46dp" android:text="✕" android:textAllCaps="false" android:textSize="16sp" android:textColor="@color/discord_red" android:background="@android:color/transparent" android:minHeight="0dp" android:minWidth="0dp" />
                    </LinearLayout>

                    <!-- APPLICATION ID -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="APPLICATION ID" android:textColor="@color/text_secondary" android:textSize="11sp" android:letterSpacing="0.08" />
                        <Button android:id="@+id/btnHowAppId" android:layout_width="wrap_content" android:layout_height="30dp" android:text="¿Como crear?" android:textAllCaps="false" android:textSize="11sp" android:textColor="@color/text_accent" android:background="@android:color/transparent" android:minHeight="0dp" android:minWidth="0dp" />
                    </LinearLayout>

                    <EditText android:id="@+id/etAppId" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:hint="123456789012345678" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:backgroundTint="@color/discord_blurple" android:inputType="number" android:singleLine="true" android:textSize="13sp" android:fontFamily="monospace" android:paddingHorizontal="14dp" android:background="@drawable/glass_input" />

                    <TextView android:id="@+id/tvTokenHint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SETTINGS -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/glass_border">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:background="@drawable/glass_input">
                        <View android:id="@+id/tvPermStatus" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/dot_red" />
                        <TextView android:id="@+id/tvPermLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Usage Access: Requerido" android:textColor="@color/discord_red" android:textSize="13sp" android:layout_marginStart="10dp" />
                        <Button android:id="@+id/btnPermissions" android:layout_width="wrap_content" android:layout_height="34dp" android:text="Permisos" android:textAllCaps="false" android:textSize="12sp" android:textColor="@color/white" android:background="@drawable/gradient_button" android:minHeight="0dp" android:minWidth="0dp" android:paddingHorizontal="16dp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Frecuencia" android:textColor="@color/text_primary" android:textSize="14sp" />
                        <TextView android:id="@+id/tvInterval" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3s" android:textColor="@color/text_accent" android:textSize="16sp" android:textStyle="bold" android:fontFamily="monospace" />
                    </LinearLayout>

                    <SeekBar android:id="@+id/seekInterval" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:max="5" android:progress="1" android:progressTint="@color/discord_blurple" android:thumbTint="@color/discord_blurple" android:splitTrack="false" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- START/STOP -->
            <Button android:id="@+id/btnStartStop" android:layout_width="match_parent" android:layout_height="56dp" android:text="INICIAR" android:textAllCaps="true" android:textSize="16sp" android:textStyle="bold" android:letterSpacing="0.05" android:textColor="@color/white" android:background="@drawable/gradient_button" android:layout_marginTop="24dp" android:elevation="8dp" />

            <!-- LOG -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardCornerRadius="16dp" app:cardBackgroundColor="@color/bg_card" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/glass_border">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOG" android:textColor="@color/text_hint" android:textSize="10sp" android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tvLog" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="@color/text_secondary" android:textSize="11sp" android:fontFamily="monospace" android:layout_marginTop="8dp" android:maxLines="10" android:lineSpacingExtra="2dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
