<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="48dp"
            android:paddingBottom="100dp">

            <!-- STATUS -->
            <LinearLayout
                android:id="@+id/cardStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/ios_card"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View android:id="@+id/tvStatusDot" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/dot_gray" />

                    <TextView android:id="@+id/tvStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Inactivo" android:textColor="@color/ios_text" android:textSize="17sp" android:textStyle="bold" android:layout_marginStart="10dp" />

                    <TextView android:id="@+id/tvCurrentApp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/ios_text2" android:textSize="13sp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ios_separator" android:layout_marginVertical="12dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="App detectada" android:textColor="@color/ios_text2" android:textSize="15sp" />
                    <TextView android:id="@+id/tvAppName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/ios_text" android:textSize="15sp" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- TOKEN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/ios_card"
                android:layout_marginTop="8dp"
                android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Discord Token" android:textColor="@color/ios_text2" android:textSize="13sp" />

                <EditText android:id="@+id/etToken" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:hint="token..." android:textColor="@color/ios_text" android:textColorHint="@color/ios_text3" android:backgroundTint="@color/ios_blue" android:inputType="textPassword" android:singleLine="true" android:textSize="15sp" android:fontFamily="monospace" android:paddingHorizontal="12dp" android:background="@drawable/ios_input" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
                    <Button android:id="@+id/btnShowToken" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Mostrar" android:textAllCaps="false" android:textSize="13sp" android:textColor="@color/ios_blue" android:background="@android:color/transparent" android:minHeight="0dp" android:minWidth="0dp" />
                    <Button android:id="@+id/btnClearToken" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Limpiar" android:textAllCaps="false" android:textSize="13sp" android:textColor="@color/ios_red" android:background="@android:color/transparent" android:minHeight="0dp" android:minWidth="0dp" />
                    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                    <Button android:id="@+id/btnHowToken" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Ayuda" android:textAllCaps="false" android:textSize="13sp" android:textColor="@color/ios_blue" android:background="@android:color/transparent" android:minHeight="0dp" android:minWidth="0dp" />
                </LinearLayout>

                <TextView android:id="@+id/tvTokenHint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- SETTINGS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/ios_card"
                android:layout_marginTop="8dp"
                android:padding="16dp">

                <!-- Permiso -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <View android:id="@+id/tvPermStatus" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/dot_red" />
                    <TextView android:id="@+id/tvPermLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Usage Access" android:textColor="@color/ios_text" android:textSize="15sp" android:layout_marginStart="10dp" />
                    <Button android:id="@+id/btnPermissions" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Abrir" android:textAllCaps="false" android:textSize="13sp" android:textColor="@color/ios_blue" android:background="@android:color/transparent" android:minHeight="0dp" android:minWidth="0dp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ios_separator" android:layout_marginVertical="12dp" />

                <!-- Frecuencia -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Frecuencia" android:textColor="@color/ios_text" android:textSize="15sp" />
                    <TextView android:id="@+id/tvInterval" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3s" android:textColor="@color/ios_blue" android:textSize="15sp" />
                </LinearLayout>

                <SeekBar android:id="@+id/seekInterval" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:max="5" android:progress="1" android:progressTint="@color/ios_blue" android:thumbTint="@color/ios_blue" android:splitTrack="false" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ios_separator" android:layout_marginVertical="12dp" />

                <!-- Asset -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/dot_green" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Icono (Art Asset)" android:textColor="@color/ios_text" android:textSize="15sp" android:layout_marginStart="10dp" />
                    <Button android:id="@+id/btnHowAsset" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Subir" android:textAllCaps="false" android:textSize="13sp" android:textColor="@color/ios_blue" android:background="@android:color/transparent" android:minHeight="0dp" android:minWidth="0dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- LOG -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/ios_card"
                android:layout_marginTop="8dp"
                android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Registro" android:textColor="@color/ios_text2" android:textSize="13sp" />

                <TextView android:id="@+id/tvLog" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="@color/ios_text3" android:textSize="12sp" android:fontFamily="monospace" android:layout_marginTop="8dp" android:maxLines="8" android:lineSpacingExtra="3dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- BUTTON -->
    <Button android:id="@+id/btnStartStop" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginHorizontal="16dp" android:layout_marginBottom="24dp" android:text="INICIAR" android:textAllCaps="true" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/white" android:background="@drawable/ios_button" android:elevation="0dp" />

</LinearLayout>
