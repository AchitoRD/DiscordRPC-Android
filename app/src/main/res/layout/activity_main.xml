<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/orbit_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="48dp"
                android:paddingBottom="120dp">

                <!-- Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISCORD RPC"
                    android:textColor="@color/orbit_muted"
                    android:textSize="11sp"
                    android:letterSpacing="0.15"
                    android:textStyle="bold" />

                <!-- NOW PLAYING CARD -->
                <LinearLayout
                    android:id="@+id/cardNowPlaying"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/orbit_now_card"
                    android:padding="20dp"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:id="@+id/dotStatus"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:background="@drawable/dot_gray" />

                        <TextView
                            android:id="@+id/tvNowPlayingLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Inactivo"
                            android:textColor="@color/orbit_text"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:layout_marginStart="10dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvElapsed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/orbit_muted"
                            android:textSize="12sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp"
                        android:id="@+id/rowCurrentApp"
                        android:visibility="gone">

                        <View
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/orbit_avatar" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/tvAppName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="App"
                                android:textColor="@color/orbit_text"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPackageName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="com.app"
                                android:textColor="@color/orbit_muted"
                                android:textSize="11sp"
                                android:fontFamily="monospace"
                                android:maxLines="1"
                                android:ellipsize="end" />
                        </LinearLayout>
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="14dp"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/orbit_bar_bg" />
                </LinearLayout>

                <!-- SETTINGS CARD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/orbit_card"
                    android:padding="16dp"
                    android:layout_marginTop="12dp">

                    <!-- Token -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Discord Token"
                        android:textColor="@color/orbit_muted"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etToken"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:hint="pega tu token..."
                        android:textColor="@color/orbit_text"
                        android:textColorHint="@color/orbit_muted2"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:paddingHorizontal="12dp"
                        android:background="@drawable/orbit_input"
                        android:textCursorDrawable="@color/orbit_periwinkle" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvTokenHint"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text=""
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btnShowToken"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:gravity="center"
                            android:text="Mostrar"
                            android:textSize="12sp"
                            android:textColor="@color/orbit_periwinkle"
                            android:paddingHorizontal="8dp" />

                        <TextView
                            android:id="@+id/btnClearToken"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:gravity="center"
                            android:text="Limpiar"
                            android:textSize="12sp"
                            android:textColor="@color/orbit_coral"
                            android:paddingHorizontal="8dp" />

                        <TextView
                            android:id="@+id/btnHowToken"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:gravity="center"
                            android:text="Ayuda"
                            android:textSize="12sp"
                            android:textColor="@color/orbit_periwinkle"
                            android:paddingHorizontal="8dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/orbit_line"
                        android:layout_marginVertical="12dp" />

                    <!-- Permission -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:id="@+id/dotPerm"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:background="@drawable/dot_gray" />

                        <TextView
                            android:id="@+id/tvPermLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Usage Access"
                            android:textColor="@color/orbit_text"
                            android:textSize="15sp"
                            android:layout_marginStart="10dp" />

                        <TextView
                            android:id="@+id/btnPermissions"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:gravity="center"
                            android:text="Abrir"
                            android:textSize="13sp"
                            android:textColor="@color/orbit_periwinkle"
                            android:paddingHorizontal="8dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/orbit_line"
                        android:layout_marginVertical="12dp" />

                    <!-- Interval -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Frecuencia"
                            android:textColor="@color/orbit_text"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvInterval"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2s"
                            android:textColor="@color/orbit_periwinkle"
                            android:textSize="15sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekInterval"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:max="5"
                        android:progress="0"
                        android:progressTint="@color/orbit_periwinkle"
                        android:thumbTint="@color/orbit_periwinkle"
                        android:splitTrack="false" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/orbit_line"
                        android:layout_marginVertical="12dp" />

                    <!-- Art Assets -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:background="@drawable/dot_green" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Iconos (Art Assets)"
                            android:textColor="@color/orbit_text"
                            android:textSize="15sp"
                            android:layout_marginStart="10dp" />

                        <TextView
                            android:id="@+id/btnHowAsset"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:gravity="center"
                            android:text="Info"
                            android:textSize="13sp"
                            android:textColor="@color/orbit_periwinkle"
                            android:paddingHorizontal="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- LOG CARD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/orbit_card"
                    android:padding="16dp"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Registro"
                            android:textColor="@color/orbit_muted"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/btnClearLog"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:gravity="center"
                            android:text="Limpiar"
                            android:textSize="12sp"
                            android:textColor="@color/orbit_muted2"
                            android:paddingHorizontal="8dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/orbit_muted2"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginTop="8dp"
                        android:maxLines="12" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- BOTTOM NAVBAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/orbit_navbar"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="10dp">

                <TextView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:gravity="center"
                    android:text="⌂"
                    android:textColor="@color/orbit_periwinkle"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inicio"
                    android:textColor="@color/orbit_periwinkle"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="10dp">

                <TextView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:gravity="center"
                    android:text="⚙"
                    android:textColor="@color/orbit_muted2"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ajustes"
                    android:textColor="@color/orbit_muted2"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navAbout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="10dp">

                <TextView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:gravity="center"
                    android:text="?"
                    android:textColor="@color/orbit_muted2"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Info"
                    android:textColor="@color/orbit_muted2"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- FAB START/STOP -->
    <TextView
        android:id="@+id/fabStartStop"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="88dp"
        android:gravity="center"
        android:text="▶"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:background="@drawable/orbit_button"
        android:elevation="6dp" />

</FrameLayout>
