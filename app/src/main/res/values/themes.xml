<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DiscordRPC" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/orbit_periwinkle</item>
        <item name="colorPrimaryVariant">@color/orbit_periwinkle_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/orbit_periwinkle</item>
        <item name="android:statusBarColor">@color/orbit_bg_outer</item>
        <item name="android:navigationBarColor">@color/orbit_bg_outer</item>
        <item name="android:windowBackground">@color/orbit_bg_outer</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="OrbitDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:background">@drawable/orbit_card</item>
        <item name="android:textColorPrimary">@color/orbit_text</item>
        <item name="android:textColorSecondary">@color/orbit_muted</item>
        <item name="colorAccent">@color/orbit_periwinkle</item>
    </style>
</resources>
